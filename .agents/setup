#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

echo "==> Checking Go toolchain"
required="1.24.0"
current=""
if command -v go >/dev/null 2>&1; then
  current="$(go version 2>/dev/null | sed -n 's/.*go\([0-9.]*\).*/\1/p' || true)"
fi
if [[ -z "$current" ]] || [[ "$(printf '%s\n' "$required" "$current" | sort -V | head -n1)" != "$required" ]]; then
  case "$(uname -m)" in
    x86_64) go_arch="amd64" ;;
    aarch64|arm64) go_arch="arm64" ;;
    *) echo "Unsupported architecture: $(uname -m)" >&2; exit 1 ;;
  esac
  echo "==> Installing Go $required"
  curl -fsSLo /tmp/go.tgz "https://go.dev/dl/go${required}.linux-${go_arch}.tar.gz"

  install_parent=/usr/local
  privilege=()
  if [[ "$(id -u)" -ne 0 ]] && [[ ! -w "$install_parent" ]]; then
    if command -v sudo >/dev/null 2>&1 && sudo -n true 2>/dev/null; then
      privilege=(sudo -n)
    else
      install_parent="$HOME/.local"
      mkdir -p "$install_parent"
    fi
  fi
  "${privilege[@]}" rm -rf "$install_parent/go"
  "${privilege[@]}" tar -C "$install_parent" -xzf /tmp/go.tgz
  rm -f /tmp/go.tgz
  export PATH="$install_parent/go/bin:$PATH"
fi
go version

if [[ -f go.mod ]]; then
  echo "==> Downloading Go modules"
  time go mod download
else
  echo "==> No go.mod found; no dependencies to install"
fi

echo "==> Orb setup complete"
