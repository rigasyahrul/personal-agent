# Generate a unique secret of at least 32 random characters. Never commit deploy/.env.
BOOTSTRAP_TOKEN=replace-with-at-least-32-random-characters

# Canonical model configuration (comma-separated provider:model_id pairs).
OPENAI_API_KEY=
# Optional OpenAI-compatible API endpoint override.
OPENAI_BASE_URL=
PA_MODELS=openai:gpt-5

# Local plain HTTP requires false. Set true when using the Caddy "domain" TLS profile.
PA_SECURE_COOKIES=false
# Used by the optional Caddy "domain" profile.
PA_DOMAIN=agent.example.com
